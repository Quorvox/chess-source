# Пример настроек. Скопируй в .env (или /etc/quorchess.env на сервере), значения впиши свои. Реальные ключи в git не кладём.
NODE_ENV=production
PORT=3410
DATA_DIR=/opt/quorchess/data
PUBLIC_URL=https://chess.example.com

# Отдельный скрытый адрес админки (без него админки нет вообще)
ADMIN_HOST=admin.example.com

# Telegram-бот: вход по ссылке, заявки на галочки, уведомления
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# TG_POLL=0          выключить чтение сообщений ботом
# TG_EMOJI={}        id премиум-эмодзи (json), если бот может их использовать

# Письма подтверждения почты (без этого письма просто не отправляются)
# SMTP_URL=smtps://user:password@smtp.example.com
# MAIL_FROM="QuorChess <no-reply@example.com>"

# Вход через Discord (необязательно)
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# BOT_BADGE=1        показывать плашку «бот» у всех ботов (иначе включается по каждому боту в админке)
