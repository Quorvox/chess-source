# Скрытый адрес админки. Положить в sites-available, certbot выпускает сертификат.
# Поиск не индексирует, вход только по паролю и коду из приложения-аутентификатора, попытки входа ограничены.

# в http-секции (например, /etc/nginx/conf.d/qc-admin-limit.conf):
# limit_req_zone $binary_remote_addr zone=qc_admin:10m rate=10r/m;

server {
    listen 80;
    server_name admin.example.com;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl http2;
    server_name admin.example.com;
    ssl_certificate     /etc/letsencrypt/live/admin.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.example.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 500k;

    location = /api/admin-login {
        limit_req zone=qc_admin burst=3 nodelay;
        proxy_pass http://127.0.0.1:3410;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location / {
        proxy_pass http://127.0.0.1:3410;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
